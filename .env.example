# ==============================================================================
# Racana — Environment Configuration
# ==============================================================================

# Application
PORT=3005
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# ------------------------------------------------------------------------------
# Database (PostgreSQL via Prisma ORM)
# ------------------------------------------------------------------------------
# For local standalone dev with dockerized postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manuscript_book_out?schema=public"
# Inside docker-compose:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/manuscript_book_out?schema=public"

# ------------------------------------------------------------------------------
# Background Queue & Cache (Redis + BullMQ)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
# Inside docker-compose:
# REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3-compatible)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="manuscripts"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
# Fallback to local storage if MinIO is unreachable during local testing:
STORAGE_FALLBACK_DIR="./storage"

# ------------------------------------------------------------------------------
# Authentication (HMAC-signed session cookie + email magic links via Resend)
# ------------------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3005"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET="generate-a-real-32-byte-hex-secret"
# Google OAuth (optional — button is hidden unless BOTH are set).
# Redirect URI to register: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Test-harness escape hatches — never set these in real production:
# ALLOW_IN_MEMORY_DB="true"   # allows DB-less mode even in production builds
# ALLOW_DEV_MAGIC_LINK="true" # returns the magic link in the API response

# ------------------------------------------------------------------------------
# Razorpay (Indian payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Transactional Email (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="Racana <books@racana.studio>"

# ------------------------------------------------------------------------------
# Analytics (optional — first-party /api/events table is always on)
# ------------------------------------------------------------------------------
# Umami/Plausible-compatible script endpoint + site id. Leave empty to disable.
NEXT_PUBLIC_UMAMI_SRC=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""

# ------------------------------------------------------------------------------
# Worker process (optional)
# ------------------------------------------------------------------------------
# "false" disables the embedded BullMQ consumer — use when running the
# dedicated worker process: npm run worker
# RACANA_EMBEDDED_WORKER="false"

# ------------------------------------------------------------------------------
# Typesetting Engine
# ------------------------------------------------------------------------------
# Locked choice: typst (Part 1 uses pipeline orchestration stubs; Part 2 renders Typst templates)
TYPESETTING_ENGINE="typst"

# ------------------------------------------------------------------------------
# AI Manuscript Analysis (OpenAI Compatible)
# ------------------------------------------------------------------------------
OPENAI_COMPATIBLE_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="sk-placeholder"
OPENAI_MODEL="gpt-4o"

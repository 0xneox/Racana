# Racana Dedicated Worker Container (BullMQ Consumer + Typst)
#
# Consumes render jobs from the shared BullMQ Redis queue and runs Typst.
# This container is intentionally separate from the Next.js web app because:
#   1. Typst renders take 3–15 minutes (Vercel functions have 60s hard limit).
#   2. The worker needs the Typst binary + open-license fonts on disk.
#   3. It never serves HTTP (except a tiny /health probe).
#
# Connects to the SAME Postgres + Redis as the web app, so jobs enqueued by
# the web app are picked up immediately by this container. Migrations are
# applied by the web deploy only — never from here (two migrators race).
#
# Node 20+: pdfjs-dist 5 (PDF manuscripts, print-QA text check) requires it.

FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

FROM base AS builder
RUN apk add --no-cache python3 make g++
COPY package.json package-lock.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npx prisma generate
# The worker is bundled to one plain-JS file (node_modules stay external), so
# no TypeScript loader runs in production.
RUN npm run build:worker
RUN npm prune --omit=dev --legacy-peer-deps

FROM base AS runner
ENV NODE_ENV=production
ENV RACANA_ROOT=/app
RUN apk add --no-cache curl

# Typst on PATH as a fallback — the renderer prefers the pinned bin/typst.
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then TYPST_ARCH="aarch64-unknown-linux-musl"; \
    else TYPST_ARCH="x86_64-unknown-linux-musl"; fi && \
    curl -fsSL "https://github.com/typst/typst/releases/download/v0.11.1/typst-${TYPST_ARCH}.tar.xz" | tar -xJ && \
    mv "typst-${TYPST_ARCH}/typst" /usr/local/bin/ && \
    rm -rf "typst-${TYPST_ARCH}" && \
    typst --version

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 racana

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist/worker.cjs ./dist/worker.cjs
# Typst engine assets: pinned binary, embedded fonts, .typ templates.
COPY --from=builder /app/bin ./bin
COPY --from=builder /app/src/lib/renderer ./src/lib/renderer

# Fail the build (not the first customer job) if the engine assets are missing.
RUN chmod +x bin/typst && \
    test -f src/lib/renderer/typst/templates/classic.typ && \
    test -f src/lib/renderer/typst/templates/modern.typ && \
    test -f src/lib/renderer/fonts/EBGaramond/EBGaramond-Regular.ttf

RUN mkdir -p /app/.typst-render-tmp /app/storage && \
    chown -R racana:nodejs /app/.typst-render-tmp /app/storage

USER racana
EXPOSE 9090
ENV PORT=9090

CMD ["node", "dist/worker.cjs"]

{
  "key": "academic",
  "displayName": "Academic",
  "personality": "Structured Scholarly",
  "trimDefaults": {
    "trimSize": "6x9",
    "marginTopMm": 20,
    "marginBottomMm": 20,
    "marginInsideMm": 23,
    "marginOutsideMm": 18
  },
  "body": {
    "fontFamily": "Source Serif 4",
    "fontSizePt": 10.5,
    "leadingEm": 1.3,
    "firstLineIndentMm": 4.5,
    "paragraphSpacingMm": 1.5
  },
  "heading": {
    "fontFamily": "Source Sans 3",
    "h1SizePt": 18,
    "h2SizePt": 14,
    "h3SizePt": 12,
    "spacingBeforeMm": 14,
    "spacingAfterMm": 5
  },
  "margins": {
    "insideMm": 23,
    "outsideMm": 18,
    "topMm": 20,
    "bottomMm": 20
  },
  "layout": {
    "chapterOpenRecto": true,
    "runningHeaders": true,
    "runningHeaderFormat": "book-title|chapter-title",
    "pageNumbersPosition": "outer_header",
    "orphanWidowTarget": 4,
    "bleedMm": 3.175,
    "bleedEnabled": false
  },
  "quote": {
    "indentLeftMm": 12,
    "indentRightMm": 12,
    "fontSizeAdjustEm": 0.9,
    "italic": true
  },
  "fontsEmbed": [
    {
      "family": "Source Serif 4",
      "file": "SourceSerif4-Regular.ttf",
      "weights": [400, 401, 700]
    },
    {
      "family": "Source Sans 3",
      "file": "SourceSans3-Regular.ttf",
      "weights": [400, 700]
    }
  ]
}

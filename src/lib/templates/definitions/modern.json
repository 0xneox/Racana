{
  "key": "modern",
  "displayName": "Modern",
  "personality": "Clean Minimal",
  "trimDefaults": {
    "trimSize": "5.5x8.5",
    "marginTopMm": 17,
    "marginBottomMm": 17,
    "marginInsideMm": 19,
    "marginOutsideMm": 13
  },
  "body": {
    "fontFamily": "Source Serif 4",
    "fontSizePt": 11,
    "leadingEm": 1.4,
    "firstLineIndentMm": 0,
    "paragraphSpacingMm": 2.5
  },
  "heading": {
    "fontFamily": "Source Sans 3",
    "h1SizePt": 22,
    "h2SizePt": 15,
    "h3SizePt": 12.5,
    "spacingBeforeMm": 9,
    "spacingAfterMm": 3
  },
  "margins": {
    "insideMm": 19,
    "outsideMm": 13,
    "topMm": 17,
    "bottomMm": 17
  },
  "layout": {
    "chapterOpenRecto": false,
    "runningHeaders": true,
    "runningHeaderFormat": "title_chapter",
    "pageNumbersPosition": "outer_header",
    "orphanWidowTarget": 2,
    "bleedMm": 3.175,
    "bleedEnabled": false
  },
  "quote": {
    "indentLeftMm": 10,
    "indentRightMm": 10,
    "fontSizeAdjustEm": 0.92,
    "italic": false
  },
  "fontsEmbed": [
    {
      "family": "Source Serif 4",
      "file": "SourceSerif4-Regular.ttf",
      "weights": [
        400,
        700
      ]
    },
    {
      "family": "Source Sans 3",
      "file": "SourceSans3-Regular.ttf",
      "weights": [
        400,
        700
      ]
    }
  ]
}
